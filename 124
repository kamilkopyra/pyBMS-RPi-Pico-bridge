        .pec-true  { color:#4caf50; }
        .pec-false { color:#f44336; }
    </style>
</head>
<body>
    <h2>ADBMS6832 - napiecia ogniw (przez mostek Pico)</h2>
    <p>
        CT: {{ ct }}
        &nbsp;|&nbsp; PEC:
        <span class="{{ 'pec-true' if pec else 'pec-false' }}">{{ pec }}</span>
        &nbsp;|&nbsp; cal_state: {{ cal_state }}
        &nbsp;|&nbsp; Ostatni update: {{ ts }}
    </p>
    <table>
        <tr>
            <th>Cell</th>
            <th>Raw [V]</th>
            <th>Filtered [V]</th>
